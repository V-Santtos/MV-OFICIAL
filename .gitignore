# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# moldura de preview local — NUNCA vai pro deploy (ver ANEXO-REGRAS §8)
/public/preview-mobile.html

# probes = ferramenta de DEV LOCAL, fica FORA do repo (ver regras/02-git-deploy-vercel.md).
# Motivo: o pacote `playwright` baixa ~130MB de browser no postinstall, e a Vercel instala
# devDependencies no build. Por isso `playwright` também não entra no package.json.
/probes/

# typescript
*.tsbuildinfo
next-env.d.ts
