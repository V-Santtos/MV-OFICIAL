# URL canônica usada em metadata, sitemap, robots, JSON-LD e llms.txt.
NEXT_PUBLIC_SITE_URL=https://www.mvesteticaautomotiva.com.br

# Fallback para verificação por meta tag (propriedade de prefixo de URL).
# Para propriedade de domínio no Search Console, prefira a verificação por DNS.
GOOGLE_SITE_VERIFICATION=

# ID do fluxo Web do Google Analytics 4. Exemplo: G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ID do Meta Pixel (Facebook/Instagram). Só dígitos, 15 ou 16. Ex.: 1234567890123456.
# Diferente do GA, o Pixel TAMBÉM carrega em dev (validação no Meta Pixel Helper).
NEXT_PUBLIC_META_PIXEL_ID=
